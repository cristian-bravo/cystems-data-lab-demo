---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dashboard ejecutivo | CYSTEMS Data Lab"
  description="Dashboard interactivo de referencia conectado a la API educativa de CYSTEMS."
  active="dashboard"
>
  <section class="page-hero">
    <div class="shell">
      <div class="crumb"><a href="/">Inicio</a><span>›</span><span>Dashboard ejecutivo</span></div>
      <p class="eyebrow">Caso CYSTEMS · Ventas y rentabilidad</p>
      <h1 class="section-title">Una lectura ejecutiva de los datos.</h1>
      <p class="section-copy">Filtra el resultado, identifica patrones y compara esta referencia con el reporte que construirás en Power BI.</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="shell">
      <div class="card filter-bar">
        <div class="field"><label for="yearFilter">Año</label><select id="yearFilter"><option value="">Todos</option><option value="2026" selected>2026</option><option value="2025">2025</option></select></div>
        <div class="field"><label for="regionFilter">Ciudad</label><select id="regionFilter"><option value="">Todas</option><option>Quito</option><option>Guayaquil</option><option>Cuenca</option><option>Manta</option></select></div>
        <div class="field"><label for="channelFilter">Canal</label><select id="channelFilter"><option value="">Todos</option><option>Venta directa</option><option>Referido</option><option>Web</option><option>Alianza</option></select></div>
      </div>

      <div class="source-banner"><span><strong id="sourceText">Consultando la API…</strong> · Última lectura <span id="updatedAt">—</span></span><span class="pill">Datos actualizables</span></div>

      <div class="kpi-grid" id="kpiGrid">
        <article class="card kpi loading"><div class="kpi-label">Ventas netas <span>↗</span></div><div class="kpi-value" data-kpi="ventas">—</div><p class="kpi-note">Facturación después de descuentos</p></article>
        <article class="card kpi loading"><div class="kpi-label">Margen <span>◆</span></div><div class="kpi-value" data-kpi="margen">—</div><p class="kpi-note">Contribución comercial</p></article>
        <article class="card kpi loading"><div class="kpi-label">Margen % <span>%</span></div><div class="kpi-value" data-kpi="margenPct">—</div><p class="kpi-note">Rentabilidad sobre ventas</p></article>
        <article class="card kpi loading"><div class="kpi-label">Transacciones <span>#</span></div><div class="kpi-value" data-kpi="transacciones">—</div><p class="kpi-note">Registros del período</p></article>
      </div>

      <div class="dashboard-grid">
        <article class="card panel">
          <div class="panel-head"><h2>Tendencia mensual de ventas</h2><span id="trendMeta">12 meses</span></div>
          <svg class="chart" id="salesChart" viewBox="0 0 760 260" role="img" aria-label="Gráfico de tendencia mensual">
            <defs><linearGradient id="chartStroke" x1="0" x2="1"><stop stop-color="#7c3aed"/><stop offset="1" stop-color="#3b82f6"/></linearGradient><linearGradient id="chartFill" x1="0" x2="0" y1="0" y2="1"><stop stop-color="#7c3aed" stop-opacity=".24"/><stop offset="1" stop-color="#3b82f6" stop-opacity="0"/></linearGradient></defs>
            <g id="chartGrid"></g><path class="chart-area" id="chartArea"></path><path class="chart-line" id="chartLine"></path><g id="chartDots"></g><g id="chartLabels"></g>
          </svg>
        </article>
        <article class="card panel">
          <div class="panel-head"><h2>Productos con mayor venta</h2><span>Top 5</span></div>
          <div class="rank-list" id="productRanking"><div class="empty loading">Calculando ranking…</div></div>
        </article>
      </div>

      <div class="dashboard-grid">
        <article class="card panel">
          <div class="panel-head"><h2>Desempeño por región</h2><span>Ventas netas</span></div>
          <div class="rank-list" id="regionRanking"><div class="empty loading">Calculando regiones…</div></div>
        </article>
        <article class="card panel">
          <div class="panel-head"><h2>Lectura ejecutiva</h2><span>Insights automáticos</span></div>
          <div class="lesson-content" id="insights"><p class="loading">Interpretando los datos…</p></div>
        </article>
      </div>
    </div>
  </section>

  <script is:inline>
    const money = new Intl.NumberFormat('es-EC',{style:'currency',currency:'USD',notation:'compact',maximumFractionDigits:1});
    const percent = new Intl.NumberFormat('es-EC',{style:'percent',maximumFractionDigits:1});
    const integer = new Intl.NumberFormat('es-EC');
    const filters = ['yearFilter','regionFilter','channelFilter'].map(id => document.getElementById(id));
    const esc = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));

    function rank(container, rows, valueKey='ventas') {
      if (!rows?.length) { container.innerHTML='<div class="empty">No hay datos para este filtro.</div>'; return; }
      const max = Math.max(...rows.map(row => row[valueKey]));
      container.innerHTML = rows.slice(0,5).map((row,index) => `<div class="rank-row"><b>${index+1}</b><div><strong>${esc(row.nombre)}</strong><div class="rank-track"><i style="width:${(row[valueKey]/max)*100}%"></i></div></div><small>${money.format(row[valueKey])}</small></div>`).join('');
    }

    function drawChart(rows) {
      const width=760, height=260, left=34, right=18, top=18, bottom=38;
      const chartWidth=width-left-right, chartHeight=height-top-bottom;
      const values=rows.map(r => r.ventas), max=Math.max(...values,1), min=Math.min(...values,0);
      const x=i => left + (rows.length===1 ? chartWidth/2 : i*chartWidth/(rows.length-1));
      const y=v => top + chartHeight - ((v-min)/(max-min || 1))*chartHeight;
      const points=rows.map((r,i)=>[x(i),y(r.ventas)]);
      const line=points.map((p,i)=>`${i?'L':'M'} ${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' ');
      document.getElementById('chartLine').setAttribute('d',line);
      document.getElementById('chartArea').setAttribute('d',`${line} L ${points.at(-1)?.[0] ?? left} ${top+chartHeight} L ${points[0]?.[0] ?? left} ${top+chartHeight} Z`);
      document.getElementById('chartGrid').innerHTML=[0,.25,.5,.75,1].map(n=>`<line class="chart-grid-line" x1="${left}" y1="${top+chartHeight*n}" x2="${width-right}" y2="${top+chartHeight*n}"/>`).join('');
      document.getElementById('chartDots').innerHTML=points.map(p=>`<circle class="chart-dot" cx="${p[0]}" cy="${p[1]}" r="4"/>`).join('');
      document.getElementById('chartLabels').innerHTML=rows.map((r,i)=>`<text x="${x(i)}" y="${height-12}" text-anchor="middle" fill="currentColor" opacity=".56" font-size="10">${r.etiqueta}</text>`).join('');
    }

    async function loadDashboard() {
      document.querySelectorAll('.kpi').forEach(el=>el.classList.add('loading'));
      const [year,region,channel]=filters.map(el=>el.value);
      const params=new URLSearchParams(); if(year) params.set('anio',year); if(region) params.set('region',region); if(channel) params.set('canal',channel);
      try {
        const response=await fetch(`/api/v1/resumen.json?${params}`); if(!response.ok) throw new Error('No se pudo consultar la API');
        const result=await response.json(); const s=result.data;
        document.querySelector('[data-kpi="ventas"]').textContent=money.format(s.ventas);
        document.querySelector('[data-kpi="margen"]').textContent=money.format(s.margen);
        document.querySelector('[data-kpi="margenPct"]').textContent=percent.format(s.margen_pct);
        document.querySelector('[data-kpi="transacciones"]').textContent=integer.format(s.transacciones);
        document.querySelectorAll('.kpi').forEach(el=>el.classList.remove('loading'));
        document.getElementById('sourceText').textContent=result.meta.source==='google-sheets'?'Fuente: Google Sheets':'Fuente: conjunto de demostración';
        document.getElementById('updatedAt').textContent=new Date(result.meta.generated_at).toLocaleTimeString('es-EC',{hour:'2-digit',minute:'2-digit'});
        drawChart(s.meses); rank(document.getElementById('productRanking'),s.productos); rank(document.getElementById('regionRanking'),s.regiones);
        document.getElementById('trendMeta').textContent=`${s.meses.length} períodos`;
        const best=s.productos[0], bestRegion=s.regiones[0];
        document.getElementById('insights').innerHTML=`<p><strong>${esc(best?.nombre ?? 'Sin producto líder')}</strong> concentra la mayor venta del período con ${money.format(best?.ventas ?? 0)}.</p><p><strong>${esc(bestRegion?.nombre ?? 'Sin región líder')}</strong> lidera el resultado regional con ${money.format(bestRegion?.ventas ?? 0)}.</p><p>El margen global es <strong>${percent.format(s.margen_pct)}</strong>. Contrasta el volumen con la rentabilidad antes de recomendar una acción.</p>`;
      } catch(error) {
        document.getElementById('sourceText').textContent='API no disponible';
        document.getElementById('insights').innerHTML=`<p class="empty">${esc(error.message)}. Intenta actualizar la página.</p>`;
      }
    }
    filters.forEach(el=>el.addEventListener('change',loadDashboard)); loadDashboard();
  </script>
</BaseLayout>
