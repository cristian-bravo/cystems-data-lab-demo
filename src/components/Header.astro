---
const { active = '' } = Astro.props;
const links = [
  { href: '/estudiar', label: 'Estudiar', key: 'estudiar' },
  { href: '/dashboard', label: 'Dashboard', key: 'dashboard' },
  { href: '/datos', label: 'Base de datos', key: 'datos' },
  { href: '/api', label: 'API', key: 'api' },
];
---

<header class="site-header">
  <div class="shell header-frame">
    <a class="brand" href="/" aria-label="CYSTEMS Data Lab">
      <img class="brand-light" src="/logo-cystems-light.webp" alt="CYSTEMS" width="210" height="70" />
      <img class="brand-dark" src="/logo-cystems-dark.webp" alt="CYSTEMS" width="210" height="70" />
      <span>DATA LAB</span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      {links.map((link) => (
        <a href={link.href} class:list={['nav-link', { active: active === link.key }]}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <span class="live-dot"><i></i>API en vivo</span>
      <button class="theme-toggle" type="button" aria-label="Cambiar tema" data-theme-toggle>
        <span class="sun">☀</span><span class="moon">☾</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const root = document.documentElement;
  const saved = localStorage.getItem('cystems-student-theme');
  const preferred = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  root.dataset.theme = saved || preferred;
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('cystems-student-theme', root.dataset.theme);
  });
</script>
